[includeIf "gitdir:~/go/src/github.com/bzhtux/"]
	path = ~/.gitconfig_personal

[includeIf "gitdir:~/Documents/src/github.com/bzhtux/**"]
	path = ~/.gitconfig_personal

[includeIf "gitdir:~/workdir/src/github.com/vmware-tanzu/"]
	path = ~/.gitconfig_vmware

[includeIf "gitdir:~/Documents/src/github.com/vmware-tanzu-labs/**"]
	path = ~/.gitconfig_vmware

[includeIf "gitdir:~/workdir/src/github.com/vmware-tanzu/tanzu-application-platform-reference-service-packages/"]
	path = ~/.gitconfig_vmware

[includeIf "gitdir:~/workdir/src/gitlab.eng.vmware.com/"]
	path = ~/.gitconfig_vmware


[push]
	default = current

[credential]
	helper = osxkeychain

